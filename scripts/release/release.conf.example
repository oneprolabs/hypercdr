# HyperCDR release configuration.
# Copy this file to release.conf and adjust values for the target environment.

# Required: OCI registry namespace prefix used for all HyperCDR release images.
HCDR_IMAGE_REGISTRY=192.168.8.149:5001/hypercdr

# Optional: registry authentication. Prefer running `docker login` once. If
# automation is required, keep the password file outside Git.
HCDR_REGISTRY_SERVER=192.168.8.149:5001
HCDR_REGISTRY_USERNAME=admin
HCDR_REGISTRY_PASSWORD_FILE=/data/harbor/harbor_admin_password

# Platform candidate registration. The token is generated by the standalone
# installer and can register releases only; it cannot start an upgrade.
HCDR_PLATFORM_URL=https://192.168.8.149:3002
HCDR_RELEASE_TOKEN_FILE=/var/lib/hypercdr/release-token
# Set this when the platform certificate is signed by a trusted private CA.
# HCDR_PLATFORM_CA_FILE=/path/to/platform-ca.crt

# Build dependency mirrors.
HCDR_BUILD_GOPROXY=https://goproxy.cn,direct
HCDR_BUILD_NPM_REGISTRY=https://registry.npmmirror.com
HCDR_VELERO_PLUGIN_SOURCE_REGISTRY=docker.m.daocloud.io/velero

# External work and dependency caches. Builds do not write generated files into source.
HCDR_RUNTIME_ROOT=/data/hypercdr-runtime
HCDR_BUILD_ROOT=/data/hypercdr-runtime/build/platform
HCDR_CACHE_ROOT=/data/hypercdr-runtime/cache

# Optional runtime images exposed by /install.sh. Defaults derive from HCDR_IMAGE_REGISTRY.
# HCDR_VELERO_IMAGE=192.168.8.149:5001/hypercdr/velero:v1.17.1-hcdr.1-20260716
# HCDR_VELERO_AWS_PLUGIN_IMAGE=192.168.8.149:5001/hypercdr/velero-plugin-for-aws:v1.13.0

# Optional behavior defaults. CLI flags override these.
HCDR_RELEASE_SKIP_TESTS=false
