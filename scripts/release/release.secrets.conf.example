#!/usr/bin/env bash
# Local release credentials. Copy this file to release.secrets.conf, set mode
# 0600, and never commit or publish the populated file.

# Alibaba Cloud Container Registry credentials used by `docker login` before
# images are built and pushed. Use either the inline password or password file.
HCDR_REGISTRY_USERNAME=
HCDR_REGISTRY_PASSWORD=
# HCDR_REGISTRY_PASSWORD_FILE=/secure/path/aliyun-acr-password

# Cloudflare Turnstile Secret Key matching HCDR_TURNSTILE_SITE_KEY in
# release.conf. It is embedded into the private installer so a newly installed
# control plane can verify browser tokens without additional configuration.
HCDR_TURNSTILE_SECRET_KEY=

# Optional Release Center bearer token file when publication is enabled.
# HCDR_RELEASE_CENTER_TOKEN_FILE=/secure/path/release-center-token
