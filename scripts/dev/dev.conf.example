# HyperCDR source development mode for host 149.
HCDR_DEV_HOST=192.168.8.149
HCDR_RUNTIME_ROOT=/data/hypercdr-runtime
HCDR_DEV_DIR=/data/hypercdr-runtime/dev
HCDR_DEV_FRONTEND_PORT=3002
HCDR_DEV_API_PORT=18080
HCDR_DEV_POSTGRES_PORT=15432
HCDR_DEV_REUSE_PLATFORM_POSTGRES=true
HCDR_PLATFORM_DEPLOY_ENV=/var/lib/hypercdr/.env

HCDR_DEV_TLS_CERT_FILE=/data/hypercdr-runtime/certs/platform.crt
HCDR_DEV_TLS_KEY_FILE=/data/hypercdr-runtime/certs/platform.key

HCDR_IMAGE_REGISTRY=192.168.8.149:5001/hypercdr
HCDR_AGENT_IMAGE=192.168.8.149:5001/hypercdr/comm-agent:v20260716.2
HCDR_VELERO_IMAGE=192.168.8.149:5001/hypercdr/velero:v1.17.1-hcdr.1-20260716
HCDR_VELERO_AWS_PLUGIN_IMAGE=192.168.8.149:5001/hypercdr/velero-plugin-for-aws:v1.13.0
HCDR_REGISTRY_CA_PATH=/data/harbor/cert/hypercdr-ca.crt

HCDR_BUILD_GOPROXY=https://goproxy.cn,direct
HCDR_BUILD_NPM_REGISTRY=https://registry.npmmirror.com
HCDR_CACHE_ROOT=/data/hypercdr-runtime/cache
HCDR_LOG_LEVEL=debug

# Authentication development settings. Never reveal reset tokens publicly.
HCDR_PASSWORD_RESET_REVEAL_TOKEN=true

# Google OAuth (optional). Authorized redirect URI:
# https://192.168.8.149:3002/api/v1/auth/google/callback
# HCDR_GOOGLE_CLIENT_ID=
# HCDR_GOOGLE_CLIENT_SECRET=

# SMTP password reset delivery (recommended outside development).
# HCDR_SMTP_HOST=smtp.example.com
# HCDR_SMTP_PORT=587
# HCDR_SMTP_USERNAME=
# HCDR_SMTP_PASSWORD=
# HCDR_SMTP_FROM=HyperCDR <noreply@example.com>
