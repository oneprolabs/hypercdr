diff --git a/repo/cachemetrics/observer.go b/repo/cachemetrics/observer.go
new file mode 100644
index 0000000..cce83cb
--- /dev/null
+++ b/repo/cachemetrics/observer.go
@@ -0,0 +1,90 @@
+package cachemetrics
+
+import (
+	"context"
+	"sync"
+)
+
+type Snapshot struct {
+	Version        int   `json:"version"`
+	IndexEnabled   bool  `json:"indexEnabled"`
+	DataEnabled    bool  `json:"dataEnabled"`
+	IndexHitBytes  int64 `json:"indexHitBytes"`
+	IndexReadBytes int64 `json:"indexReadBytes"`
+	DataHitBytes   int64 `json:"dataHitBytes"`
+	DataReadBytes  int64 `json:"dataReadBytes"`
+}
+
+type Observer struct {
+	mu      sync.Mutex
+	stats   Snapshot
+	indexes map[string]bool
+}
+type observerKey struct{}
+type readKey struct{}
+type fileKey struct{}
+type Read struct{ Hit bool }
+type Range struct{ Start, End int64 }
+
+func New(indexEnabled, dataEnabled bool) *Observer {
+	return &Observer{stats: Snapshot{Version: 1, IndexEnabled: indexEnabled, DataEnabled: dataEnabled}}
+}
+func WithObserver(ctx context.Context, observer *Observer) context.Context {
+	return context.WithValue(ctx, observerKey{}, observer)
+}
+func FromContext(ctx context.Context) *Observer {
+	observer, _ := ctx.Value(observerKey{}).(*Observer)
+	return observer
+}
+func (observer *Observer) Snapshot() Snapshot {
+	observer.mu.Lock()
+	defer observer.mu.Unlock()
+	return observer.stats
+}
+func WithRead(ctx context.Context) (context.Context, *Read) {
+	read := &Read{}
+	return context.WithValue(ctx, readKey{}, read), read
+}
+func MarkHit(ctx context.Context) {
+	if read, ok := ctx.Value(readKey{}).(*Read); ok {
+		read.Hit = true
+	}
+}
+func WithFileRead(ctx context.Context, enabled bool) context.Context {
+	return context.WithValue(ctx, fileKey{}, enabled)
+}
+func IsFileRead(ctx context.Context) bool { enabled, _ := ctx.Value(fileKey{}).(bool); return enabled }
+func RecordIndex(ctx context.Context, id string, total int64, hit bool) {
+	if observer := FromContext(ctx); observer != nil && total > 0 {
+		observer.mu.Lock()
+		defer observer.mu.Unlock()
+		if observer.indexes == nil {
+			observer.indexes = map[string]bool{}
+		}
+		if observer.indexes[id] {
+			return
+		}
+		observer.indexes[id] = true
+		observer.stats.IndexReadBytes += total
+		if hit {
+			observer.stats.IndexHitBytes += total
+		}
+	}
+}
+func RecordData(ctx context.Context, total, hit int64) {
+	if observer := FromContext(ctx); observer != nil && IsFileRead(ctx) && total > 0 {
+		observer.mu.Lock()
+		defer observer.mu.Unlock()
+		observer.stats.DataReadBytes += total
+		observer.stats.DataHitBytes += hit
+	}
+}
+func Hits(ranges []Range, start, length int64) int64 {
+	var total int64
+	for _, span := range ranges {
+		if overlap := min(start+length, span.End) - max(start, span.Start); overlap > 0 {
+			total += overlap
+		}
+	}
+	return total
+}
diff --git a/repo/cachemetrics/observer_test.go b/repo/cachemetrics/observer_test.go
new file mode 100644
index 0000000..e88ed47
--- /dev/null
+++ b/repo/cachemetrics/observer_test.go
@@ -0,0 +1,45 @@
+package cachemetrics
+
+import (
+	"context"
+	"sync"
+	"testing"
+)
+
+func TestTaskIsolationAndConcurrentReads(t *testing.T) {
+	first, second := New(true, true), New(true, false)
+	firstCtx := WithFileRead(WithObserver(context.Background(), first), true)
+	secondCtx := WithObserver(context.Background(), second)
+	var workers sync.WaitGroup
+	for index := 0; index < 50; index++ {
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			RecordData(firstCtx, 100, 75)
+			RecordIndex(secondCtx, "same-index", 10, true)
+		}()
+	}
+	workers.Wait()
+	if stats := first.Snapshot(); stats.DataReadBytes != 5000 || stats.DataHitBytes != 3750 || stats.IndexReadBytes != 0 {
+		t.Fatal(stats)
+	}
+	if stats := second.Snapshot(); stats.DataReadBytes != 0 || stats.IndexHitBytes != 10 {
+		t.Fatal(stats)
+	}
+	RecordData(WithFileRead(firstCtx, false), 100, 100)
+	if first.Snapshot().DataReadBytes != 5000 {
+		t.Fatal("nested or metadata read counted")
+	}
+}
+
+func TestReadMarkersAndRanges(t *testing.T) {
+	ctx, first := WithRead(context.Background())
+	nested, second := WithRead(ctx)
+	MarkHit(nested)
+	if first.Hit || !second.Hit {
+		t.Fatal("read origins mixed")
+	}
+	if total := Hits([]Range{{Start: 0, End: 10}, {Start: 20, End: 30}}, 5, 20); total != 10 {
+		t.Fatal(total)
+	}
+}
