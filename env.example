# Public platform address and agent connection endpoint.
HCDR_PUBLIC_BASE_URL=https://hypercdr.example.com
HCDR_AGENT_WS_ENDPOINT=wss://hypercdr.example.com/ws/agent

# Harbor project used for platform and managed-cluster images.
HCDR_IMAGE_REGISTRY=harbor.example.com/hypercdr
HCDR_AGENT_IMAGE=harbor.example.com/hypercdr/comm-agent:vYYYYMMDD.N
HCDR_VELERO_IMAGE=harbor.example.com/hypercdr/velero:v1.17.1
HCDR_VELERO_AWS_PLUGIN_IMAGE=harbor.example.com/hypercdr/velero-plugin-for-aws:v1.13.0

# Runtime secrets must be generated for each installation. Never commit them.
HCDR_POSTGRES_PASSWORD=replace-me
HCDR_SECRET_KEY=replace-me
HCDR_RELEASE_TOKEN=replace-me

# Persistent standalone-host installation directory.
HCDR_DATA_DIR=/var/lib/hypercdr
