# Production blue/green reference only; NOT a ready-to-run installation.
# deploy/online/install.sh generates real secrets, image versions, TLS, nginx
# configuration and the installed release manifest. Do not copy placeholder
# secrets into a deployed platform. See docs/deployment/build-release-install.md.
# HCDR_AUTH_CHALLENGE_MODE supports captcha (image) and turnstile (Cloudflare).
# Turnstile requires both site and secret keys. Blank optional values use defaults.
HCDR_AGENT_PRIVATE_WS_ENDPOINT=
HCDR_AGENT_PUBLIC_WS_ENDPOINT=
HCDR_AGENT_WS_ENDPOINT=wss://platform.example.com:12443/ws/agent
HCDR_AUTH_CHALLENGE_MODE=captcha
HCDR_BASE_URL=https://platform.example.com:12443
HCDR_BLUE_RELEASE_MANIFEST_PATH=
HCDR_DATABASE_URL=postgres://hypercdr:replace-me@hypercdr-postgres:5432/hypercdr?sslmode=disable
HCDR_EDGE_IMAGE=registry.cn-beijing.aliyuncs.com/oneprolabs/hypercdr:nginx-1.27-alpine
HCDR_GREEN_RELEASE_MANIFEST_PATH=
HCDR_HTTPS_PORT=12443
HCDR_IMAGE_REGISTRY=registry.cn-beijing.aliyuncs.com/oneprolabs/hypercdr
HCDR_INSTALL_DIR=/var/lib/hypercdr
HCDR_NGINX_CONFIG_DIR=/var/lib/hypercdr/nginx/conf.d
HCDR_PLATFORM_CA_DIR=/var/lib/hypercdr/platform-ca
HCDR_POSTGRES_PASSWORD=replace-me
HCDR_PUBLIC_BASE_URL=https://platform.example.com:12443
HCDR_REGISTRATION_EXECUTOR_TOKEN=replace-me
HCDR_REGISTRY_CA_FILE=/dev/null
HCDR_REGISTRY_CA_PATH=
HCDR_RELEASE_MANIFEST_PATH=/deploy/current-release.json
HCDR_RELEASE_TOKEN=replace-me
HCDR_SECRET_KEY=replace-me
HCDR_TLS_CERT_FILE=/var/lib/hypercdr/tls/tls.crt
HCDR_TLS_KEY_FILE=/var/lib/hypercdr/tls/tls.key
HCDR_TURNSTILE_SECRET_KEY=
HCDR_TURNSTILE_SITE_KEY=
HCDR_TURNSTILE_VERIFY_URL=
HCDR_WEBSITE_NGINX_CONFIG_FILE=/var/lib/hypercdr/nginx/website.conf
HCDR_WEBSITE_PORT=12445
PLATFORM_API_BLUE_IMAGE=registry.cn-beijing.aliyuncs.com/oneprolabs/hypercdr:platform-api-RELEASE_VERSION
PLATFORM_API_GREEN_IMAGE=registry.cn-beijing.aliyuncs.com/oneprolabs/hypercdr:platform-api-RELEASE_VERSION
PLATFORM_FRONTEND_BLUE_IMAGE=registry.cn-beijing.aliyuncs.com/oneprolabs/hypercdr:platform-frontend-RELEASE_VERSION
PLATFORM_FRONTEND_GREEN_IMAGE=registry.cn-beijing.aliyuncs.com/oneprolabs/hypercdr:platform-frontend-RELEASE_VERSION
POSTGRES_IMAGE=registry.cn-beijing.aliyuncs.com/oneprolabs/hypercdr:postgres-16
REGISTRATION_EXECUTOR_IMAGE=registry.cn-beijing.aliyuncs.com/oneprolabs/hypercdr:cluster-registration-executor-RELEASE_VERSION
